[user]
    name = CAMBIA_TU_NOMBRE
    email = CAMBIA_TU_EMAIL

[core]
    editor = vim
    autocrlf = input
    pager = less -FRX

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true

[alias]
    lg = log --graph --oneline --decorate --all
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    wip = !git add -A && git commit -m 'chore: wip'
    st = status -sb
    co = checkout
    br = branch
    last = log -1 HEAD --stat

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3
