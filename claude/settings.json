{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git log*)",
      "Bash(git stash*)",
      "Bash(git show*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(git commit*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(symfony console *)",
      "Bash(php artisan *)",
      "Bash(phpunit *)",
      "Bash(jest *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(docker compose *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(make *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(tree *)",
      "Bash(echo *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(diff *)",
      "Bash(printf *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(readlink *)",
      "Bash(stat *)",
      "Bash(date *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(fd *)",
      "Bash(fdfind *)",
      "Bash(cat .env)",
      "Bash(cat package.json)",
      "Bash(cat composer.json)",
      "Bash(cat tsconfig.json)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(cat .env.*)",
      "Bash(cat *credentials*)",
      "Bash(cat *secret*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Read(**/.env.*)",
      "Read(**/credentials/**)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)"
    ],
    "defaultMode": "auto"
  },
  "outputStyle": "jarvis",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/notify-hook.sh\" 'Claude Code' 'Turno terminado' normal /usr/share/sounds/freedesktop/stereo/complete.oga"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/notify-hook.sh\" 'Claude Code' 'Necesita tu atención' critical /usr/share/sounds/freedesktop/stereo/message.oga"
          }
        ]
      }
    ]
  }
}