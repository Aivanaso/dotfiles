      "Bash(rm -rf .ai-team/*)",
      "Bash(cat package.json)",
      "Bash(cat composer.json)",
      "Bash(cat tsconfig.json)",
      "mcp__pencil"
    ],
    "deny": [
      "Bash(cat .env*)",
      "Bash(cat *credentials*)",
      "Bash(cat *secret*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(credentials/*)",
      "Read(secrets/*)",
      "Read(.ssh/*)",
      "Read(*.pem)",
      "Read(*.key)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git push --force*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)"
    ]
