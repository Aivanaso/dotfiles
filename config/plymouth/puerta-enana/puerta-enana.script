/*
 * puerta-enana — Plymouth script theme.
 *
 * Una puerta enana de piedra de noche. Los grabados de plata se encienden
 * poco a poco con el progreso del arranque (o con el porcentaje, durante
 * actualizaciones offline) y, una vez encendidos, laten suavemente hasta que
 * aparece la pantalla de login.
 * A dwarven stone gate at night. The silver engravings light up with boot
 * progress (or with the update percentage during offline updates), then pulse
 * gently until the login screen appears.
 *
 * Los PNG los genera generate_frames.py; las lineas AddLayer(...) de abajo
 * llevan las posiciones de los recortes y el generador falla si no coinciden.
 * The PNGs come from generate_frames.py; the AddLayer(...) lines below carry
 * the crop positions and the generator fails if they go out of date.
 */

// ------------------------------------------------------------------ Escena
// Scene geometry: the PNGs are baked on a 1000x960 canvas (1:1 up to 1080p
// screens; on smaller screens everything is scaled down, never up).

global.SCENE_WIDTH = 1000;
global.SCENE_HEIGHT = 960;
global.FRAME_RATE = 30;               // refresh callbacks per second
global.OPACITY_STEPS = 40;            // opacities are quantised; sprites are only touched when one changes

Window.SetBackgroundTopColor(0.0196, 0.0314, 0.0549);      // 0x05080e, the edge colour of base.png
Window.SetBackgroundBottomColor(0.0196, 0.0314, 0.0549);
Plymouth.SetRefreshRate(global.FRAME_RATE);

global.scale = Math.Min(1, Window.GetHeight() * 0.92 / global.SCENE_HEIGHT);
global.scene_x = Window.GetX() + Math.Int((Window.GetWidth() - global.SCENE_WIDTH * global.scale) / 2);
global.scene_y = Window.GetY() + Math.Int((Window.GetHeight() - global.SCENE_HEIGHT * global.scale) / 2);

// Text colour and fonts. "Sans" resolves to whatever the initramfs ships
// (Ubuntu) and to the desktop font on a full system.
global.TEXT_FONT = "Sans 13";
global.PROMPT_FONT = "Sans 12";
global.TEXT_RED = 0.88;
global.TEXT_GREEN = 0.92;
global.TEXT_BLUE = 1.0;

fun ScaledInt(value) {
    return Math.Int(value * global.scale + 0.5);
}

fun LoadImage(name) {
    local.image = Image(name + ".png");
    if (global.scale < 1) {
        image = image.Scale(ScaledInt(image.GetWidth()), ScaledInt(image.GetHeight()));
    }
    return image;
}

fun Quantise(value) {
    return Math.Int(Math.Clamp(value, 0, 1) * global.OPACITY_STEPS) / global.OPACITY_STEPS;
}

// ------------------------------------------------------------------ Capas
// Layers are cropped PNGs placed on the scene, in lighting order.
// halo = 0, moon = 1, glow-01 .. glow-13 = 2 .. 14.

global.HALO = 0;
global.MOON = 1;
global.FIRST_GLOW = 2;
global.GLOW_COUNT = 13;

global.layers = [];
global.layer_count = 0;

fun AddLayer(name, x, y) {
    local.index = global.layer_count;
    global.layers[index].sprite = Sprite(LoadImage(name));
    global.layers[index].sprite.SetPosition(global.scene_x + ScaledInt(x), global.scene_y + ScaledInt(y), 10 + index);
    global.layers[index].sprite.SetOpacity(0);
    global.layers[index].opacity = 0;
    global.layer_count = index + 1;
}

fun SetLayerOpacity(index, value) {
    local.quantised = Quantise(value);
    if (quantised != global.layers[index].opacity) {
        global.layers[index].opacity = quantised;
        global.layers[index].sprite.SetOpacity(quantised);
    }
}

global.base_sprite = Sprite(LoadImage("base"));
global.base_sprite.SetPosition(global.scene_x, global.scene_y, 0);

AddLayer("halo", 172, 232);
AddLayer("moon", 92, 87);
AddLayer("glow-01", 281, 266);
AddLayer("glow-02", 548, 273);
AddLayer("glow-03", 211, 359);
AddLayer("glow-04", 627, 359);
AddLayer("glow-05", 345, 295);
AddLayer("glow-06", 307, 187);
AddLayer("glow-07", 226, 114);
AddLayer("glow-08", 258, 136);
AddLayer("glow-09", 478, 140);
AddLayer("glow-10", 371, 328);
AddLayer("glow-11", 461, 328);
AddLayer("glow-12", 425, 603);
AddLayer("glow-13", 96, 800);

// ------------------------------------------------------------- Centelleos
// Twinkling sky glints: x, y (centre, scene coordinates), image 1..3.

global.TWINKLE_COUNT = 9;
global.twinkles = [];
global.twinkle_images = [];

fun AddTwinkle(index, x, y, kind) {
    if (!global.twinkle_images[kind]) {
        global.twinkle_images[kind] = LoadImage("twinkle-" + kind);
    }
    local.image = global.twinkle_images[kind];
    global.twinkles[index].sprite = Sprite(image);
    global.twinkles[index].sprite.SetPosition(
        global.scene_x + ScaledInt(x) - Math.Int(image.GetWidth() / 2),
        global.scene_y + ScaledInt(y) - Math.Int(image.GetHeight() / 2),
        5);
    global.twinkles[index].sprite.SetOpacity(0);
    global.twinkles[index].opacity = 0;
    global.twinkles[index].speed = 0.05 + 0.023 * (index % 4);
    global.twinkles[index].phase = index * 1.9;
}

AddTwinkle(0, 70, 90, 1);
AddTwinkle(1, 250, 60, 2);
AddTwinkle(2, 330, 150, 1);
AddTwinkle(3, 610, 70, 3);
AddTwinkle(4, 700, 120, 1);
AddTwinkle(5, 800, 200, 2);
AddTwinkle(6, 900, 130, 1);
AddTwinkle(7, 940, 330, 3);
AddTwinkle(8, 60, 300, 2);

// --------------------------------------------------------- Placa de texto
// The message tablet is baked into base.png (scene y 866..944). Status and
// message lines sit on it; the password prompt reuses the same space.

global.PLATE_CENTER_Y = 905;
global.PROMPT_Y = 872;
global.ENTRY_Y = 898;
global.ENTRY_WIDTH = 360;
global.BULLET_PITCH = 18;
global.MAX_BULLETS = 18;

global.entry_image = LoadImage("entry");
global.entry_sprite = Sprite(global.entry_image);
global.entry_sprite.SetPosition(
    global.scene_x + ScaledInt((global.SCENE_WIDTH - global.ENTRY_WIDTH) / 2),
    global.scene_y + ScaledInt(global.ENTRY_Y),
    110);
global.entry_sprite.SetOpacity(0);

global.bullet_image = LoadImage("bullet");
global.bullets = [];

global.status_sprite = Sprite();
global.message_sprite = Sprite();
global.prompt_sprite = Sprite();
global.answer_sprite = Sprite();

// ------------------------------------------------------------------ Estado
global.mode = Plymouth.GetMode();
global.frame = 0;
global.level = 0;                   // 0..1, how much of the gate is lit
global.boot_progress = 0;           // 0..1 from plymouth
global.update_percent = 0;          // 0..100 during offline updates
global.update_seen = 0;             // 1 once a system-update callback fired
global.fsck_percent = -1;           // -1 = no disk check running
global.message = "";
global.password_active = 0;
global.question_active = 0;

// ------------------------------------------------------------- Texto / UI
fun TextImage(text, font) {
    return Image.Text(text, global.TEXT_RED, global.TEXT_GREEN, global.TEXT_BLUE, 1, font);
}

fun IsUpdateMode() {
    if (global.update_seen) return 1;
    if (global.mode == "updates") return 1;
    if (global.mode == "system-upgrade") return 1;
    if (global.mode == "firmware-upgrade") return 1;
    if (global.mode == "system-reset") return 1;
    return 0;
}

fun UpdateTitle() {
    if (global.mode == "system-upgrade") return "Actualizando el sistema";
    if (global.mode == "firmware-upgrade") return "Actualizando el firmware";
    if (global.mode == "system-reset") return "Restableciendo el sistema";
    return "Instalando actualizaciones";
}

fun StatusLine() {
    if (global.fsck_percent >= 0) return "Comprobando el disco...  " + global.fsck_percent + " %";
    if (IsUpdateMode()) return UpdateTitle() + "...  " + Math.Int(global.update_percent) + " %";
    return "";
}

// Place one centred text sprite; returns the height it used.
fun PlaceCentred(sprite, text, font, y) {
    local.image = TextImage(text, font);
    sprite.SetImage(image);
    sprite.SetPosition(
        global.scene_x + ScaledInt(global.SCENE_WIDTH / 2) - Math.Int(image.GetWidth() / 2),
        y,
        100);
    sprite.SetOpacity(1);
    return image.GetHeight();
}

// Status line (updates / disk check) and the latest message, stacked in the plate.
fun RenderStatusText() {
    global.status_sprite.SetOpacity(0);
    global.message_sprite.SetOpacity(0);
    if (global.password_active || global.question_active) return 0;

    local.status = StatusLine();
    local.lines = 0;
    if (status != "") lines = lines + 1;
    if (global.message != "") lines = lines + 1;
    if (lines == 0) return 0;

    local.line_height = TextImage("Ag", global.TEXT_FONT).GetHeight();
    local.top = global.scene_y + ScaledInt(global.PLATE_CENTER_Y) - Math.Int((lines * line_height + (lines - 1) * 4) / 2);
    if (status != "") {
        PlaceCentred(global.status_sprite, status, global.TEXT_FONT, top);
        top = top + line_height + 4;
    }
    if (global.message != "") {
        PlaceCentred(global.message_sprite, global.message, global.TEXT_FONT, top);
    }
}

fun HidePasswordUI() {
    global.entry_sprite.SetOpacity(0);
    global.prompt_sprite.SetOpacity(0);
    global.answer_sprite.SetOpacity(0);
    local.i = 0;
    while (global.bullets[i]) {
        global.bullets[i].SetOpacity(0);
        i++;
    }
}

fun ShowPrompt(prompt) {
    global.entry_sprite.SetOpacity(1);
    PlaceCentred(global.prompt_sprite, prompt, global.PROMPT_FONT, global.scene_y + ScaledInt(global.PROMPT_Y));
}

// ------------------------------------------------------ Callbacks de plymouth
fun BootProgressCallback(duration, progress) {
    global.boot_progress = progress;
}
Plymouth.SetBootProgressFunction(BootProgressCallback);

// offline updates / upgrades: progress is the percentage 0..100
fun SystemUpdateCallback(progress) {
    global.update_seen = 1;
    global.update_percent = Math.Clamp(progress, 0, 100);
    RenderStatusText();
}
Plymouth.SetSystemUpdateFunction(SystemUpdateCallback);

fun StripPrefix(text, prefix, prefix_length) {
    if (String(text).SubString(0, prefix_length) == prefix) {
        local.length = 0;
        while (String(text).CharAt(length) != "") {
            length++;
        }
        return String(text).SubString(prefix_length, length);
    }
    return text;
}

// plymouth display-message and disk-check messages share this path
fun MessageCallback(text) {
    if (!text) text = "";
    text = StripPrefix(text, "keys:", 5);
    text = StripPrefix(text, "fsckd-cancel-msg:", 17);
    global.message = text;
    RenderStatusText();
}
Plymouth.SetDisplayMessageFunction(MessageCallback);

fun HideMessageCallback(text) {
    global.message = "";
    RenderStatusText();
}
Plymouth.SetHideMessageFunction(HideMessageCallback);

fun DigitValue(character) {
    local.d = 0;
    while (d < 10) {
        if (character == d + "") return d;
        d++;
    }
    return -1;
}

// "fsck:<device>:<percent>" -> remember the percentage (the device name is not shown)
fun UpdateStatusCallback(status) {
    if (String(status).SubString(0, 5) != "fsck:") return 0;
    local.last_colon = 4;
    local.length = 0;
    while (String(status).CharAt(length) != "") {
        if (String(status).CharAt(length) == ":") last_colon = length;
        length++;
    }
    local.percent = 0;
    local.digits = 0;
    local.i = last_colon + 1;
    while (i < length) {
        local.digit = DigitValue(String(status).CharAt(i));
        if (digit < 0) break;
        percent = percent * 10 + digit;
        digits++;
        i++;
    }
    if (digits == 0) return 0;
    if (percent >= 100) percent = -1;
    global.fsck_percent = percent;
    RenderStatusText();
}
Plymouth.SetUpdateStatusFunction(UpdateStatusCallback);

// disk-encryption passphrase: prompt + one lozenge per typed character
fun DisplayPasswordCallback(prompt, bullet_count) {
    global.password_active = 1;
    global.question_active = 0;
    RenderStatusText();
    global.answer_sprite.SetOpacity(0);
    ShowPrompt(prompt);

    if (bullet_count > global.MAX_BULLETS) bullet_count = global.MAX_BULLETS;
    local.row_width = bullet_count * global.BULLET_PITCH;
    local.left = global.scene_x + ScaledInt((global.SCENE_WIDTH - row_width) / 2);
    local.i = 0;
    while (i < global.MAX_BULLETS) {
        if (!global.bullets[i]) {
            global.bullets[i] = Sprite(global.bullet_image);
        }
        if (i < bullet_count) {
            global.bullets[i].SetPosition(
                left + ScaledInt(i * global.BULLET_PITCH),
                global.scene_y + ScaledInt(global.ENTRY_Y + 12),
                111);
            global.bullets[i].SetOpacity(1);
        } else {
            global.bullets[i].SetOpacity(0);
        }
        i++;
    }
}
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);

// plymouth ask-question: same slot, the typed text is shown as is
fun DisplayQuestionCallback(prompt, entry_text) {
    global.question_active = 1;
    global.password_active = 0;
    RenderStatusText();
    local.i = 0;
    while (global.bullets[i]) {
        global.bullets[i].SetOpacity(0);
        i++;
    }
    ShowPrompt(prompt);
    local.answer = TextImage(entry_text + " ", global.PROMPT_FONT);
    global.answer_sprite.SetImage(answer);
    global.answer_sprite.SetPosition(
        global.scene_x + ScaledInt((global.SCENE_WIDTH - global.ENTRY_WIDTH) / 2 + 14),
        global.scene_y + ScaledInt(global.ENTRY_Y + 8),
        111);
    global.answer_sprite.SetOpacity(1);
}
Plymouth.SetDisplayQuestionFunction(DisplayQuestionCallback);

fun DisplayNormalCallback() {
    global.password_active = 0;
    global.question_active = 0;
    HidePasswordUI();
    RenderStatusText();
}
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);

// ----------------------------------------------------------- Animacion
// How lit the gate should be: update percentage, boot progress, or (shutdown /
// reboot, which report no progress) fully lit from the start.
fun TargetLevel() {
    if (IsUpdateMode()) return global.update_percent / 100;
    if (global.mode == "shutdown") return 1;
    if (global.mode == "reboot") return 1;
    local.seconds = global.frame / global.FRAME_RATE;
    local.timed = 0.99 * seconds / (seconds + 9);    // keeps creeping if plymouth progress stalls
    return Math.Max(global.boot_progress, timed);
}

fun RefreshCallback() {
    global.frame = global.frame + 1;
    global.mode = Plymouth.GetMode();

    local.target = Math.Clamp(TargetLevel(), 0, 1);
    if (target > global.level) {
        global.level = global.level + (target - global.level) * 0.05;
        if (target - global.level < 0.0005) global.level = target;
    }
    local.level = global.level;

    // Once fully lit, a slow pulse (about 3.2 s) takes over.
    local.lit_full = Math.Clamp((level - 0.92) / 0.06, 0, 1);
    local.wave = 0.5 + 0.5 * Math.Sin(global.frame * 0.0654);
    local.breathe = 1 - 0.16 * lit_full * wave;

    local.k = 0;
    while (k < global.GLOW_COUNT) {
        SetLayerOpacity(global.FIRST_GLOW + k, Math.Clamp(level * (global.GLOW_COUNT + 1) - k, 0, 1) * breathe);
        k++;
    }
    SetLayerOpacity(global.HALO, 0.25 * level + 0.5 * lit_full * (0.5 + 0.5 * Math.Sin(global.frame * 0.0654 + 1.2)));
    SetLayerOpacity(global.MOON, level * 10);

    local.t = 0;
    while (t < global.TWINKLE_COUNT) {
        local.glint = 0.5 + 0.5 * Math.Sin(global.frame * global.twinkles[t].speed + global.twinkles[t].phase);
        local.glint_opacity = Quantise(0.15 + 0.85 * glint * glint);
        if (glint_opacity != global.twinkles[t].opacity) {
            global.twinkles[t].opacity = glint_opacity;
            global.twinkles[t].sprite.SetOpacity(glint_opacity);
        }
        t++;
    }
}
Plymouth.SetRefreshFunction(RefreshCallback);
